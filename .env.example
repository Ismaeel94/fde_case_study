# Copy to .env and update values for your environment:
#   cp .env.example .env

PROJECT_NAME=FDE Case Study API
API_V1_PREFIX=
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Keycloak / OIDC
KEYCLOAK_BASE_URL=http://localhost:8080
REALM=case_study
CLIENT_ID=support_assistant
CLIENT_SECRET=your-client-secret-here
KEY_CLOAK_REDIRECT_URI=http://localhost:8000/auth/callback
KEY_CLOAK_LOGIN_URL={KEYCLOAK_BASE_URL}/realms/{REALM}/protocol/openid-connect/auth?client_id={CLIENT_ID}&response_type=code&scope=openid&redirect_uri={REDIRECT_URI}
