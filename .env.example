# Copy to .env and update values for your environment:
#   cp .env.example .env
#
# Docker Compose: use service hostnames (postgres, redis, postgres-mcp, keycloak).
# Local uvicorn with infra in Compose: use localhost and published ports instead.

PROJECT_NAME=FDE Case Study API
API_V1_PREFIX=
DEBUG=false
EVALUATE_MODE=false
HOST=0.0.0.0
PORT=8000
APP_BASE_URL=http://localhost:8000

# Browser-facing Keycloak URL (host port 8080)
KEYCLOAK_BASE_URL=http://localhost:8080
# Server-side Keycloak URL (Docker bridge network)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
REALM=case_study
CLIENT_ID=support_assistant
CLIENT_SECRET=your-client-secret-here
KEY_CLOAK_REDIRECT_URI=http://localhost:8000/auth/callback

MCP_URL=http://postgres-mcp:8080/sse
OPENAI_API_KEY=your-openai-api-key-here
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://ey_user:ey_password@postgres:5432/ey_demo

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=acme
